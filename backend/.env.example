# ── Database (external PostgreSQL) ────────────────────────
DATABASE_URL=postgresql+asyncpg://hubble:hubble%40123456@192.168.100.221:31432/tokenshare

# ── Redis (external) ──────────────────────────────────────
REDIS_URL=redis://:hubble%40123456@192.168.100.221:6379/0

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Encryption ────────────────────────────────────────────
# Used to encrypt provider API keys at rest (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Default Token Bank Rates ──────────────────────────────
DEFAULT_CREDIT_LIMIT=10000
DEFAULT_INTEREST_RATE=0.0001      # daily, ~0.01%
DEFAULT_DEBT_INTEREST_RATE=0.0005 # daily, ~0.05%

# ── Proxy ─────────────────────────────────────────────────
PROXY_MAX_RETRIES=3
PROXY_UPSTREAM_TIMEOUT=120

# ── App ───────────────────────────────────────────────────
APP_NAME=TokenBank
DEBUG=true
